# Copia este archivo como .env y llena los valores. El .env real nunca se
# sube al repositorio.

# --- Servidor ---
PORT=4000
# Ruta base de la API (por defecto /api)
API_URL=/api
# Orígenes del frontend permitidos por CORS y el socket, separados por coma
# (panel de administración y pantalla de cocina)
FRONTEND_URL=https://panel.ejemplo.com,https://cocina.ejemplo.com
APP_URL=

# --- Base de datos ---
DB_URI=mongodb+srv://usuario:clave@cluster/base

# --- Sesiones ---
JWT_Secret_key=
# Llave aparte para los tokens de las pantallas de cocina (KDS). Opcional:
# si falta se deriva de JWT_Secret_key.
JWT_DEVICE_SECRET_KEY=
# Cifrado de las tarjetas guardadas de los clientes
CARD_ENCRYPTION_KEY=

# --- Inteligencia artificial (respaldo en cascada) ---
# Se intenta Gemini; si se queda sin cuota (429), tarda o falla, Groq; y si
# también falla, OpenRouter. Un proveedor sin clave simplemente se salta.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# Modelo gratuito (sufijo ":free") que soporte herramientas
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# --- Google Maps (estimación de entregas de Panchita) ---
GOOGLE_MAPS_API_KEY=

# --- Correo (Mailjet) ---
API_KEY_MAILJET=
API_SECRET_MAILJET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# --- Cloudinary (imágenes) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Otros servicios ---
USER_EMAIL=
USER_PASSWORD=
GRANT_TYPE=
AUDIENCE=
CLIENT_ID=
CLIENT_SECRET=
